                ]
            },
            "default": [
                "OH"
            ],
            "prefill": [
                "OH"
            ]
        },
        "zipCode": {
            "title": "ZIP code (optional)",
            "type": "string",
            "description": "Search a radius around this ZIP code instead of whole states.",
            "editor": "textfield"
        },
        "radiusMiles": {
            "title": "Radius in miles",
            "type": "integer",
            "description": "Used with the ZIP code.",
            "default": 50,
            "minimum": 1,
            "maximum": 300
        },
        "companyTypes": {
            "title": "Company types (optional)",
            "type": "array",
            "description": "Keep only these kinds of companies. Leave empty for all.",
            "editor": "select",
            "items": {
                "type": "string",
                "enum": [
                    "general_contractor",
                    "specialty_contractor",
                    "supplier",
                    "manufacturer",
                    "engineer",
                    "architect",
                    "consultant",
                    "owner_developer"
                ],
                "enumTitles": [
                    "General contractor",
                    "Specialty (trade) contractor",
                    "Supplier or distributor",
                    "Manufacturer",
                    "Engineer",
                    "Architect",
                    "Consultant",
                    "Owner or developer"
                ]
            },
            "default": []
        },
        "certifications": {
            "title": "Certifications (optional)",
            "type": "array",
            "description": "Keep only companies with at least one of these, for example minority, woman or veteran owned, or union. Leave empty for all.",
            "editor": "select",
            "items": {
                "type": "string",
                "enum": [
                    "8a",
                    "aabe",
                    "abe",
                    "bepd",
                    "cab",
                    "b_corp",
                    "cbe",
                    "lgbtbe",
                    "dbe",
                    "ebe",
                    "hbe",
                    "hubzone",
                    "lbe",
                    "mbe",
                    "nabe",
                    "prevailing_wage",
                    "sdvosb",
                    "small_business",
                    "union",
                    "veteran_owned",
                    "wbe"
                ],
                "enumTitles": [
                    "SBA 8(a)",
                    "African American owned (AABE)",
                    "Asian American owned (ABE)",
                    "Disability owned (BEPD)",
                    "Certified Aboriginal Business",
                    "B Corporation",
                    "Certified Business Enterprise (CBE)",
                    "LGBT owned (LGBTBE)",
                    "Disadvantaged Business (DBE)",
                    "Emerging Business Enterprise (EBE)",
                    "Hispanic owned (HBE)",
                    "HUBZone / HUB",
                    "Locally Based Enterprise (LBE)",
                    "Minority owned (MBE)",
                    "Native American owned (NABE)",
                    "Prevailing wage",
                    "Service-disabled veteran owned (SDVOSB)",
                    "Small business",
                    "Union contractor",
                    "Veteran owned",
                    "Woman owned (WBE / WOSB)"
                ]
            },
            "default": []
        },
        "requirePhone": {
            "title": "Only companies with a phone number",
            "type": "boolean",
            "description": "Drop companies that list no phone number.",
            "default": false
        },
        "includeOutOfState": {
            "title": "Include out-of-state companies that serve the area",
            "type": "boolean",
            "description": "Off: only companies based in the chosen states. On: also companies based elsewhere that list a chosen state as a service area.",
            "default": false
        },
        "maxResults": {
            "title": "Maximum results",
            "type": "integer",
            "description": "The most companies to return (and be charged for).",
            "default": 1000,
            "minimum": 1,
            "maximum": 100000
        },
        "includeProcore": {
            "title": "Search Procore Network",
            "type": "boolean",
            "description": "Procore Network construction directory.",
            "default": true,
            "sectionCaption": "Sources and advanced options"
        },
        "includeSba": {
            "title": "Search the SBA small business search",
            "type": "boolean",
            "description": "US Small Business Administration directory of SAM.gov-registered small businesses (adds bonding capacity and federal certifications).",
            "default": true
        },
        "lookUpPhones": {
            "title": "Look up phone numbers",
            "type": "boolean",
            "description": "Procore shows phone numbers only on each company page. On: open those pages for companies without a phone.",
            "default": true
        },
        "maxPhoneLookups": {
            "title": "Maximum phone lookups",
            "type": "integer",
            "description": "Upper limit on company pages opened for phone numbers.",
            "default": 3000,
            "minimum": 0,
            "maximum": 50000
        }
    },
    "required": [
        "trades"
    ]
}
