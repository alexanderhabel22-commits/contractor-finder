{
    "title": "Find US construction contractors and subcontractors by trade",
    "description": "Pick the trades and where. The Actor searches public contractor directories (Procore Network and the SBA small business search), merges companies listed in both, and returns one list with phone, website, address, trades and certifications.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "trades": {
            "title": "Trades",
            "type": "array",
            "description": "Construction trades to look for. A company needs any one of them.",
            "editor": "select",
            "items": {
                "type": "string",
                "enum": [
                    "general_contractor",
                    "concrete",
                    "masonry",
                    "structural_steel",
                    "miscellaneous_metals",
                    "welding",
                    "carpentry",
                    "roofing",
                    "sheet_metal",
                    "waterproofing",
                    "insulation",
                    "fireproofing",
                    "siding_cladding",
                    "glass_glazing",
                    "doors_hardware",
                    "drywall_ceilings",
                    "painting",
                    "flooring",
                    "fire_protection",
                    "plumbing",
                    "hvac",
                    "process_piping",
                    "electrical",
                    "low_voltage",
                    "elevators",
                    "earthwork",
                    "utilities",
                    "paving",
                    "demolition",
                    "landscaping",
                    "fencing",
                    "abatement",
                    "scaffolding"
                ],
                "enumTitles": [
                    "General contractors & construction managers",
                    "Concrete",
                    "Masonry",
                    "Structural steel (fabrication & erection)",
                    "Miscellaneous & ornamental metals, stairs, railings",
                    "Welding contractors",
                    "Carpentry & millwork",
                    "Roofing",
                    "Sheet metal & ductwork",
                    "Waterproofing, sealants & air barriers",
                    "Insulation & EIFS",
                    "Fireproofing & firestopping",
                    "Siding, wall panels & cladding",
                    "Glass, glazing, curtain wall & storefronts",
                    "Doors, frames & hardware",
                    "Drywall, plaster, stucco & ceilings",
                    "Painting & coatings",
                    "Flooring & tile",
                    "Fire protection & sprinklers",
                    "Plumbing",
                    "HVAC & mechanical",
                    "Process & industrial piping",
                    "Electrical",
                    "Low voltage, data, security & fire alarm",
                    "Elevators & lifts",
                    "Excavation, earthwork & site work",
                    "Underground utilities, sewer & water",
                    "Paving, asphalt & pavement markings",
                    "Demolition",
                    "Landscaping & irrigation",
                    "Fencing & gates",
                    "Abatement & environmental remediation",
                    "Scaffolding"
                ]
            },
            "default": [
                "structural_steel"
            ],
            "prefill": [
                "structural_steel"
            ]
        },
        "states": {
            "title": "States",
            "type": "array",
            "description": "US states to search. Leave empty and set a ZIP code to search a radius instead.",
            "editor": "select",
            "items": {
                "type": "string",
                "enum": [
                    "AL",
                    "AK",
                    "AZ",
                    "AR",
                    "CA",
                    "CO",
                    "CT",
                    "DE",
                    "DC",
                    "FL",
                    "GA",
                    "HI",
                    "ID",
                    "IL",
                    "IN",
                    "IA",
                    "KS",
                    "KY",
                    "LA",
                    "ME",
                    "MD",
                    "MA",
                    "MI",
                    "MN",
                    "MS",
                    "MO",
                    "MT",
                    "NE",
                    "NV",
                    "NH",
                    "NJ",
                    "NM",
                    "NY",
                    "NC",
                    "ND",
                    "OH",
                    "OK",
                    "OR",
                    "PA",
                    "RI",
                    "SC",
                    "SD",
                    "TN",
                    "TX",
                    "UT",
                    "VT",
                    "VA",
                    "WA",
                    "WV",
                    "WI",
                    "WY"
                ],
                "enumTitles": [
                    "Alabama",
                    "Alaska",
                    "Arizona",
                    "Arkansas",
                    "California",
                    "Colorado",
                    "Connecticut",
                    "Delaware",
                    "District of Columbia",
                    "Florida",
